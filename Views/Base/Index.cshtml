@inject IOptions<TurnstileOptions> turnstileOptions;
@{
    ViewData["Title"] = "Furkan Tural";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" type="text/css" href="~/css/site.css" />
}

<!-- CONSENT MODAL -->
<div id="consentOverlay" class="consent-overlay">
    <div class="consent-modal" role="dialog" aria-modal="true" aria-labelledby="consentTitle">
        <div class="consent-title" id="consentTitle">
            @Localizer["Consent_Title"]
        </div>
        <div class="consent-text">
            @Html.Raw(Localizer["Consent_Text"].Value)
        </div>
        <div class="consent-actions">
            <button id="consentOk" class="btn-consent btn-consent-primary">@Localizer["Consent_Btn_Ok"]</button>
            <button id="consentClose" class="btn-consent btn-consent-muted">@Localizer["Consent_Btn_Close"]</button>
        </div>
    </div>
</div>

<!-- TOAST AREA -->
<div class="toast-wrapper" id="toastWrapper">
    <div class="toast" id="toastBox">
        <div class="toast-title" id="toastTitle">@Localizer["Toast_Title_Status"]</div>
        <div class="toast-msg" id="toastMsg">@Localizer["Toast_Msg_Default"]</div>
    </div>
</div>

<!-- HERO -->
<section id="home" class="container hero">
    <div class="hero-left reveal">
        <h1>
            @Localizer["Hero_Greeting"]
            <br />
            <span class="highlight">@Localizer["Hero_Title_1"]</span> ve
            <span class="highlight">@Localizer["Hero_Title_2"]</span>
        </h1>
        <p>
            @Localizer["Hero_Desc"]
        </p>

        <div class="hero-cta">
            <a href="#pricing"><button class="btn-primary">@Localizer["Hero_Btn_Freelance"]</button></a>
            <a href="#contact"><button class="btn-outline">@Localizer["Hero_Btn_Contact"]</button></a>
        </div>
    </div>

    <div class="hero-card reveal">
        <h2>@Localizer["Hero_Card_Title"]</h2>
        <div class="hero-tags">
            <div class="tag">.NET 8 API</div>
            <div class="tag">EF</div>
            <div class="tag">EF Core</div>
            <div class="tag">SQL Optimization</div>
            <div class="tag">Razor / MVC</div>
            <div class="tag">Security & Auth</div>
            <div class="tag">Maintenance / Refactor</div>
        </div>
        <p class="section-desc" style="margin-top:1rem;">
            @Localizer["Hero_Card_Desc"]
        </p>
    </div>
</section>

<!-- ABOUT -->
<section id="about" class="container">
    <div class="section-header reveal">
        <div class="section-eyebrow">@Localizer["About_Eyebrow"]</div>
        <div class="section-title">@Localizer["About_Title"]</div>
        <div class="section-desc">
            @Localizer["About_Desc"]
        </div>
    </div>

    <div class="about-grid reveal">
        <div class="card about-text">
            <p>
                @Localizer["About_Card_Text_1"]
            </p>
            <p>
                @Localizer["About_Card_Text_2"]
            </p>
            <p>
                @Localizer["About_Card_Text_3"]
            </p>
        </div>

        <div class="card">
            <ul class="cv-list">
                <li>
                    <div class="cv-role">
                        <span>@Localizer["About_CV_Role_1"]</span>
                        <span>@Localizer["About_CV_Date_1"]</span>
                    </div>
                    <div class="cv-company">@Localizer["About_CV_Desc_1"]</div>
                </li>
                <li>
                    <div class="cv-role">
                        <span>@Localizer["About_CV_Role_2"]</span>
                        <span>@Localizer["About_CV_Date_2"]</span>
                    </div>
                    <div class="cv-company">@Localizer["About_CV_Desc_2"]</div>
                </li>
            </ul>
        </div>
    </div>
</section>

<!-- SKILLS -->
<section id="skills" class="container">
    <div class="section-header reveal">
        <div class="section-eyebrow">@Localizer["Skills_Eyebrow"]</div>
        <div class="section-title">@Localizer["Skills_Title"]</div>
        <div class="section-desc">
            @Localizer["Skills_Desc"]
        </div>
    </div>

    <div class="skills-grid">
        <div class="skill-item reveal">
            <div class="skill-head">
                <div class="skill-name">.NET / C#</div>
                <div class="skill-level">@Localizer["Skill_Level_Expert"]</div>
            </div>
            <div class="skill-desc">
                @Localizer["Skill_Desc_1"]
            </div>
        </div>

        <div class="skill-item reveal">
            <div class="skill-head">
                <div class="skill-name">MSSQL / EF Core</div>
                <div class="skill-level">@Localizer["Skill_Level_Expert"]</div>
            </div>
            <div class="skill-desc">
                @Localizer["Skill_Desc_2"]
            </div>
        </div>

        <div class="skill-item reveal">
            <div class="skill-head">
                <div class="skill-name">Razor / MVC</div>
                <div class="skill-level">@Localizer["Skill_Level_Advanced"]</div>
            </div>
            <div class="skill-desc">
                @Localizer["Skill_Desc_3"]
            </div>
        </div>

        <div class="skill-item reveal">
            <div class="skill-head">
                <div class="skill-name">HTML / CSS / JS</div>
                <div class="skill-level">@Localizer["Skill_Level_Advanced"]</div>
            </div>
            <div class="skill-desc">
                @Localizer["Skill_Desc_4"]
            </div>
        </div>

        <div class="skill-item reveal">
            <div class="skill-head">
                <div class="skill-name">Sistem Temizliği</div>
                <div class="skill-level">@Localizer["Skill_Level_Surgeon"]</div>
            </div>
            <div class="skill-desc">
                @Localizer["Skill_Desc_5"]
            </div>
        </div>

        <div class="skill-item reveal">
            <div class="skill-head">
                <div class="skill-name">Danışmanlık</div>
                <div class="skill-level">@Localizer["Skill_Level_Partner"]</div>
            </div>
            <div class="skill-desc">
                @Localizer["Skill_Desc_6"]
            </div>
        </div>
    </div>
</section>
 
