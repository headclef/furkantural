@using Microsoft.Extensions.Options
@inject IOptions<TurnstileViewModel> turnstileOptions;
@{
    ViewData["Title"] = "Furkan Tural";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" type="text/css" href="~/css/site.css" />
}

<!-- CONSENT MODAL -->
<div id="consentOverlay" class="consent-overlay">
    <div class="consent-modal" role="dialog" aria-modal="true" aria-labelledby="consentTitle">
        <div class="consent-title" id="consentTitle">
            @Localizer["Consent_Title"]
        </div>
        <div class="consent-text">
            @Html.Raw(Localizer["Consent_Text"].Value)
        </div>
        <div class="consent-actions">
            <button id="consentOk" class="btn-consent btn-consent-primary">@Localizer["Consent_Btn_Ok"]</button>
            <button id="consentClose" class="btn-consent btn-consent-muted">@Localizer["Consent_Btn_Close"]</button>
        </div>
    </div>
</div>

<!-- TOAST AREA -->
<div class="toast-wrapper" id="toastWrapper">
    <div class="toast" id="toastBox">
        <div class="toast-title" id="toastTitle">@Localizer["Toast_Title_Status"]</div>
        <div class="toast-msg" id="toastMsg">@Localizer["Toast_Msg_Default"]</div>
    </div>
</div>

<!-- HERO -->
<section id="home" class="container hero">
    <div class="hero-left reveal">
        <h1>
            @Localizer["Hero_Greeting"]
            <br />
            <span class="highlight">@Localizer["Hero_Title_1"]</span> ve
            <span class="highlight">@Localizer["Hero_Title_2"]</span>
        </h1>
        <p>
            @Localizer["Hero_Desc"]
        </p>

        <div class="hero-cta">
            <a href="#pricing"><button class="btn-primary">@Localizer["Hero_Btn_Freelance"]</button></a>
            <a href="#contact"><button class="btn-outline">@Localizer["Hero_Btn_Contact"]</button></a>
        </div>
    </div>

    <div class="hero-card reveal">
        <h2>@Localizer["Hero_Card_Title"]</h2>
        <div class="hero-tags">
            <div class="tag">.NET 8 API</div>
            <div class="tag">EF</div>
            <div class="tag">EF Core</div>
            <div class="tag">SQL Optimization</div>
            <div class="tag">Razor / MVC</div>
            <div class="tag">Security & Auth</div>
            <div class="tag">Maintenance / Refactor</div>
        </div>
        <p class="section-desc" style="margin-top:1rem;">
            @Localizer["Hero_Card_Desc"]
        </p>
    </div>
</section>

<!-- ABOUT -->
<section id="about" class="container">
    <div class="section-header reveal">
        <div class="section-eyebrow">@Localizer["About_Eyebrow"]</div>
        <div class="section-title">@Localizer["About_Title"]</div>
        <div class="section-desc">
            @Localizer["About_Desc"]
        </div>
    </div>

    <div class="about-grid reveal">
        <div class="card about-text">
            <p>
                @Localizer["About_Card_Text_1"]
            </p>
            <p>
                @Localizer["About_Card_Text_2"]
            </p>
            <p>
                @Localizer["About_Card_Text_3"]
            </p>
        </div>

        <div class="card">
            <ul class="cv-list">
                <li>
                    <div class="cv-role">
                        <span>@Localizer["About_CV_Role_1"]</span>
                        <span>@Localizer["About_CV_Date_1"]</span>
                    </div>
                    <div class="cv-company">@Localizer["About_CV_Desc_1"]</div>
                </li>
                <li>
                    <div class="cv-role">
                        <span>@Localizer["About_CV_Role_2"]</span>
                        <span>@Localizer["About_CV_Date_2"]</span>
                    </div>
                    <div class="cv-company">@Localizer["About_CV_Desc_2"]</div>
                </li>
            </ul>
        </div>
    </div>
</section>

<!-- SKILLS -->
<section id="skills" class="container">
    <div class="section-header reveal">
        <div class="section-eyebrow">@Localizer["Skills_Eyebrow"]</div>
        <div class="section-title">@Localizer["Skills_Title"]</div>
        <div class="section-desc">
            @Localizer["Skills_Desc"]
        </div>
    </div>

    <div class="skills-grid">
        <div class="skill-item reveal">
            <div class="skill-head">
                <div class="skill-name">.NET / C#</div>
                <div class="skill-level">@Localizer["Skill_Level_Expert"]</div>
            </div>
            <div class="skill-desc">
                @Localizer["Skill_Desc_1"]
            </div>
        </div>

        <div class="skill-item reveal">
            <div class="skill-head">
                <div class="skill-name">MSSQL / EF Core</div>
                <div class="skill-level">@Localizer["Skill_Level_Expert"]</div>
            </div>
            <div class="skill-desc">
                @Localizer["Skill_Desc_2"]
            </div>
        </div>

        <div class="skill-item reveal">
            <div class="skill-head">
                <div class="skill-name">Razor / MVC</div>
                <div class="skill-level">@Localizer["Skill_Level_Advanced"]</div>
            </div>
            <div class="skill-desc">
                @Localizer["Skill_Desc_3"]
            </div>
        </div>

        <div class="skill-item reveal">
            <div class="skill-head">
                <div class="skill-name">HTML / CSS / JS</div>
                <div class="skill-level">@Localizer["Skill_Level_Advanced"]</div>
            </div>
            <div class="skill-desc">
                @Localizer["Skill_Desc_4"]
            </div>
        </div>

        <div class="skill-item reveal">
            <div class="skill-head">
                <div class="skill-name">Sistem Temizliği</div>
                <div class="skill-level">@Localizer["Skill_Level_Surgeon"]</div>
            </div>
            <div class="skill-desc">
                @Localizer["Skill_Desc_5"]
            </div>
        </div>

        <div class="skill-item reveal">
            <div class="skill-head">
                <div class="skill-name">Danışmanlık</div>
                <div class="skill-level">@Localizer["Skill_Level_Partner"]</div>
            </div>
            <div class="skill-desc">
                @Localizer["Skill_Desc_6"]
            </div>
        </div>
    </div>
</section>
 
 <!-- PROJECTS -->
 <section id="projects" class="container">
     <div class="section-header reveal">
         <div class="section-eyebrow">@Localizer["Projects_Eyebrow"]</div>
         <div class="section-title">@Localizer["Projects_Title"]</div>
         <div class="section-desc">
             @Localizer["Projects_Desc"]
         </div>
     </div>
 
     <div class="projects-grid reveal">
         <!-- Project 1 -->
         <a href="https://crypt.furkantural.com" target="_blank" class="project-card">
             <div>
                 <div class="project-domain">crypt.furkantural.com</div>
                 <div class="project-title">
                     Secure Crypt
                     <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                         <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                         <polyline points="15 3 21 3 21 9"></polyline>
                         <line x1="10" y1="14" x2="21" y2="3"></line>
                     </svg>
                 </div>
                 <div class="project-desc">
                     @Localizer["Project_1_Desc"]
                 </div>
             </div>
             <div class="project-link">
                 @Localizer["Project_Link_Text"]
             </div>
         </a>

         <!-- Project 2 -->
         <a href="https://log.furkantural.com" target="_blank" class="project-card">
             <div>
                 <div class="project-domain">log.furkantural.com</div>
                 <div class="project-title">
                     Log
                     <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                         <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                         <polyline points="15 3 21 3 21 9"></polyline>
                         <line x1="10" y1="14" x2="21" y2="3"></line>
                     </svg>
                 </div>
                 <div class="project-desc">
                     @Localizer["Project_2_Desc"]
                 </div>
             </div>
             <div class="project-link">
                 @Localizer["Project_Link_Text"]
             </div>
         </a>
 
         <!-- Placeholder for future -->
         <div class="project-card" style="opacity: 0.5; border-style: dashed; justify-content: center; align-items: center; text-align: center;">
             <div style="font-size: 2rem; margin-bottom: 1rem;">🔜</div>
             <div class="project-title" style="margin-bottom: 0;">@Localizer["Project_ComingSoon_Title"]</div>
             <div class="project-desc" style="margin-bottom: 0;">@Localizer["Project_ComingSoon_Desc"]</div>
         </div>
     </div>
 </section>

<!-- PRICING -->
<section id="pricing" class="container">
    <div class="section-header reveal">
        <div class="section-eyebrow">@Localizer["Pricing_Eyebrow"]</div>
        <div class="section-title">@Localizer["Pricing_Title"]</div>
        <div class="section-desc">
             @Localizer["Pricing_Desc"]
        </div>
    </div>

    <div class="pricing-wrap reveal">
        <!-- Paket 1 -->
        <div class="price-card">
            <div class="price-head">
                <div class="plan-name">
                    <span>@Localizer["Plan_1_Name"]</span>
                </div>
                <div class="plan-desc">
                    @Localizer["Plan_1_Desc"]
                </div>
                <div class="plan-price">@Localizer["Plan_Price_Negotiable"]</div>
            </div>

            <ul class="plan-features">
                <li><span class="check">✔</span> @Localizer["Plan_1_Feature_1"]</li>
                <li><span class="check">✔</span> @Localizer["Plan_1_Feature_2"]</li>
                <li><span class="check">✔</span> @Localizer["Plan_1_Feature_3"]</li>
            </ul>

            <div class="price-cta">
                <a href="#contact"><button class="btn-primary">@Localizer["Plan_Btn_Request"]</button></a>
            </div>
        </div>

        <!-- Paket 2 -->
        <div class="price-card" style="border:1px solid var(--accent);">
            <div class="price-head">
                <div class="plan-name">
                    <span>@Localizer["Plan_2_Name"]</span>
                    <span style="font-size:.65rem; background-color:var(--accent); color:#0f172a; font-weight:600; border-radius:.4rem; padding:.2rem .4rem; line-height:1;">@Localizer["Plan_Tag_Popular"]</span>
                </div>
                <div class="plan-desc">
                    @Localizer["Plan_2_Desc"]
                </div>
                <div class="plan-price">@Localizer["Plan_Price_Negotiable"]</div>
            </div>

            <ul class="plan-features">
                <li><span class="check">✔</span> @Localizer["Plan_2_Feature_1"]</li>
                <li><span class="check">✔</span> @Localizer["Plan_2_Feature_2"]</li>
                <li><span class="check">✔</span> @Localizer["Plan_2_Feature_3"]</li>
            </ul>

            <div class="price-cta">
                <a href="#contact"><button class="btn-primary">@Localizer["Plan_Btn_Request"]</button></a>
            </div>
        </div>

        <!-- Paket 3 -->
        <div class="price-card">
            <div class="price-head">
                <div class="plan-name">
                    <span>@Localizer["Plan_3_Name"]</span>
                </div>
                <div class="plan-desc">
                    @Localizer["Plan_3_Desc"]
                </div>
                <div class="plan-price">@Localizer["Plan_Price_Negotiable"]</div>
            </div>

            <ul class="plan-features">
                <li><span class="check">✔</span> @Localizer["Plan_3_Feature_1"]</li>
                <li><span class="check">✔</span> @Localizer["Plan_3_Feature_2"]</li>
                <li><span class="check">✔</span> @Localizer["Plan_3_Feature_3"]</li>
            </ul>

            <div class="price-cta">
                <a href="#contact"><button class="btn-primary">@Localizer["Plan_Btn_Meeting"]</button></a>
            </div>
        </div>
    </div>
</section>

<!-- CONTACT -->
<section id="contact" class="container">
    <div class="section-header reveal">
        <div class="section-eyebrow">@Localizer["Contact_Eyebrow"]</div>
        <div class="section-title">@Localizer["Contact_Title"]</div>
        <div class="section-desc">
            @Localizer["Contact_Desc"]
        </div>
    </div>

    <div class="contact-grid reveal">
        <div class="card contact-left">
            <p>
                @Localizer["Contact_Info_Text_1"]
            </p>
            <p>
                @Localizer["Contact_Info_Text_2"]
            </p>

            <div class="mt-4">
                <div style="font-size:.8rem;color:var(--text-dim);margin-bottom:.5rem; font-weight:500;">@Localizer["Contact_Other_Channels"]</div>
                <div class="social-grid">
                    <a href="https://www.linkedin.com/in/furkantural" target="_blank" class="social-card">
                        <strong>LinkedIn</strong>
                        <span>furkantural</span>
                    </a>
                    <a href="https://github.com/headclef" target="_blank" class="social-card">
                        <strong>GitHub</strong>
                        <span>headclef</span>
                    </a>
                    <a href="https://www.instagram.com/headclef" target="_blank" class="social-card">
                        <strong>Instagram</strong>
                        <span>headclef</span>
                    </a>
                    <a href="https://www.facebook.com/headcleFT" target="_blank" class="social-card">
                        <strong>Facebook</strong>
                        <span>headcleFT</span>
                    </a>
                    <a href="https://www.hackerrank.com/profile/elbisetakim" target="_blank" class="social-card">
                        <strong>HackerRank</strong>
                        <span>elbisetakim</span>
                    </a>
                </div>
            </div>
        </div>

        <div class="card">
            @using (Html.BeginForm("SendMail", "Base", method: FormMethod.Post, htmlAttributes: new { id = "contactForm" }))
            {
                @Html.AntiForgeryToken()

                <div class="field">
                    @Html.Label("NameSurname", Localizer["Form_Label_Name"].Value)
                    @Html.TextBox("NameSurname", "", htmlAttributes: new { id = "NameSurname", name = "NameSurname", type = "text", placeholder = Localizer["Form_Placeholder_Name"].Value, required = "required" })
                </div>

                <div class="field">
                    @Html.Label("Email", Localizer["Form_Label_Email"].Value)
                    @Html.TextBox("Email", "", htmlAttributes: new { id = "Email", name = "Email", type = "email", placeholder = Localizer["Form_Placeholder_Email"].Value, required = "required" })
                </div>

                <div class="field">
                    @Html.Label("MessageNeed", Localizer["Form_Label_Message"].Value)
                    @Html.TextArea("MessageNeed", "", htmlAttributes: new { id = "MessageNeed", name = "MessageNeed", placeholder = Localizer["Form_Placeholder_Message"].Value, required = "required" })
                    <div class="form-hint mt-2">
                        @Localizer["Form_Hint_Status"]
                    </div>
                </div>

                <div class="field" style="display:flex; flex-direction:column; align-items:center; gap:.5rem;">
                    <label style="font-size:.75rem;font-weight:500;color:var(--text-main);">
                        @Localizer["Form_Label_Security"]
                        <span style="font-size:.65rem;font-weight:400;color:var(--text-dim);">
                            @Localizer["Form_Label_Security_Sub"]
                        </span>
                    </label>

                    <div class="cf-turnstile"
                         data-sitekey="@turnstileOptions.Value.SiteKey"
                         data-callback="turnstileCallback"
                         data-theme="auto">
                    </div>

                    @Html.Hidden("TurnstileResponse", "", new { id = "TurnstileResponse" })

                    <div class="form-hint mt-2">
                        @Localizer["Form_Hint_Internet"]
                    </div>
                </div>

                <button type="submit" id="contactSubmitBtn" class="btn-primary" style="width:100%;">
                    @Localizer["Form_Btn_Send"]
                </button>
            }
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <script>
        function turnstileCallback(token) {
            document.getElementById("TurnstileResponse").value = token;
        }
    </script>
}