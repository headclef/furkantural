@using Microsoft.Extensions.Options
@inject IOptions<TurnstileViewModel> turnstileOptions;
@{
    ViewData["Title"] = "Furkan Tural";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" type="text/css" href="~/css/site.css" />
}

<!-- CONSENT MODAL -->
<div id="consentOverlay" class="consent-overlay">
    <div class="consent-modal" role="dialog" aria-modal="true" aria-labelledby="consentTitle">
        <div class="consent-title" id="consentTitle">
            Küçük bir şey konuşalım 👇
        </div>
        <div class="consent-text">
            Tarayıcına bazı bilgileri kaydetmem gerekli
            ve bu bilgileri mecburen senden almak zorundayım.
            <br><br>
            Ama merak etme; Bu bilgileri temayı (dark/light), form vb.
            gibi şeyler için kullanacağım. Yani bilgilerin ticari vb.
            amaçlar ile kullanılmayacak, merak etme.
        </div>
        <div class="consent-actions">
            <button id="consentOk" class="btn-consent btn-consent-primary">Anladım</button>
            <button id="consentClose" class="btn-consent btn-consent-muted">Kapat</button>
        </div>
    </div>
</div>

<!-- TOAST AREA -->
<div class="toast-wrapper" id="toastWrapper">
    <div class="toast" id="toastBox">
        <div class="toast-title" id="toastTitle">Durum</div>
        <div class="toast-msg" id="toastMsg">Mesaj</div>
    </div>
</div>

<!-- HERO -->
<section id="home" class="container hero">
    <div class="hero-left">
        <h1>
            Merhaba, ben Furkan.
            <br />
            <span class="highlight">Full-stack geliştirici</span> ve
            <span class="highlight">problem çözücü</span>.
        </h1>
        <p>
            .NET tabanlı kurumsal ve bireysel uygulamalar, entegrasyonlar, veri işleme servisleri
            dasboard ve yönetim panelleri geliştirebilir ve iyileştirebilirim.
            Performans, güvenlik ve gerçek iş ihtiyacı odaklı çalışırım.
            Estetik olurum ama arkasını da doldururum, boş iş yapmam.
        </p>

        <div class="hero-cta">
            <a href="#pricing"><button class="btn-primary">Freelance Çalışalım</button></a>
            <a href="#contact"><button class="btn-outline">İletişim Kur</button></a>
        </div>
    </div>

    <div class="hero-card">
        <h2>Neler yapabilirim?</h2>
        <div class="hero-tags">
            <div class="tag">.NET 8 API</div>
            <div class="tag">EF</div>
            <div class="tag">EF Core</div>
            <div class="tag">SQL Optimization</div>
            <div class="tag">Razor / MVC</div>
            <div class="tag">Security & Auth</div>
            <div class="tag">Maintenance / Refactor</div>
        </div>
        <p class="section-desc" style="margin-top:1rem;">
            Kurumsal projelerde performans artırması yapabilir,
            darboğaz problemlerini çözebilir,
            loglama ve güvenlik katmanları geliştirebilir ve sadeleştirebilir,
            baştan sona anahtar teslim projeler geliştirebilirim.
        </p>
    </div>
</section>

<!-- ABOUT -->
<section id="about" class="container">
    <div class="section-header">
        <div class="section-eyebrow">Özgeçmiş</div>
        <div class="section-title">Kimim?</div>
        <div class="section-desc">
            Kurumsal tarafı da anlıyorum çünkü kurumsal firmalar ile de çalışma deneyimine sahibim.
            Hali hazırda tam zamanlı çalıştışım işimde aktif olarak vb. işlerde yer almaktayım.
            Süreç, onay, bütçe, yetiştirilemeyen işler, panik durumları, teslim vakitleri...
            hepsini gördüm.
        </div>
    </div>

    <div class="about-grid">
        <div class="card about-text">
            <p>
                Back-end ağırlıklı çalışıyorum (.NET, MSSQL, servis tasarımı)
                ama front-end tarafında da rahatım (Razor, Bootstrap,
                dashboard UI, component yapıları).
            </p>
            <p>
                En sevdiğim şey: Karmaşık bir problemi alıp sade, izlenebilir,
                dökümante edilebilir hale getirmek.
            </p>
            <p>
                “Şu çalışıyor ama kimse dokunmak istemiyor,
                çünkü her şey birbirine bağlı” dediğiniz yerde ben giriyorum.
            </p>
        </div>

        <div class="card">
            <ul class="cv-list">
                <li>
                    <div class="cv-role">
                        <span>Uzman Yazılımcı Yardımcısı</span>
                        <span>2023 - Şu An</span>
                    </div>
                    <div class="cv-company">Kurumsal .NET projeleri, entegrasyon, veri işleme, özel paneller</div>
                </li>
                <li>
                    <div class="cv-role">
                        <span>Full-stack Geliştirici (Freelance)</span>
                        <span>2024 - Şu An</span>
                    </div>
                    <div class="cv-company">Özel paneller, satış raporlama, kampanya otomasyonu, proje yönetimi</div>
                </li>
            </ul>
        </div>
    </div>
</section>

<!-- SKILLS -->
<section id="skills" class="container">
    <div class="section-header">
        <div class="section-eyebrow">Yetenekler</div>
        <div class="section-title">Masaya neler koyuyorum?</div>
        <div class="section-desc">
            Kelime değil, üretim. Aşağıdakiler günlük kullandığım alanlar.
        </div>
    </div>

    <div class="skills-grid">
        <div class="skill-item">
            <div class="skill-head">
                <div class="skill-name">.NET / C#</div>
                <div class="skill-level">Uzman</div>
            </div>
            <div class="skill-desc">
                API, Windows Service, Worker Service, background task, auth, logging, caching, website.
            </div>
        </div>

        <div class="skill-item">
            <div class="skill-head">
                <div class="skill-name">MSSQL / EF Core</div>
                <div class="skill-level">Uzman</div>
            </div>
            <div class="skill-desc">
                Performans tuning, SP refactor, index analizi, veri bütünlüğü.
            </div>
        </div>

        <div class="skill-item">
            <div class="skill-head">
                <div class="skill-name">Razor / MVC</div>
                <div class="skill-level">İleri</div>
            </div>
            <div class="skill-desc">
                Admin paneller, dashboard tasarımı, validation, security.
            </div>
        </div>

        <div class="skill-item">
            <div class="skill-head">
                <div class="skill-name">HTML / CSS / JS</div>
                <div class="skill-level">İleri</div>
            </div>
            <div class="skill-desc">
                Responsive UI, dark mode, component bazlı yapı.
            </div>
        </div>

        <div class="skill-item">
            <div class="skill-head">
                <div class="skill-name">Sistem Temizliği</div>
                <div class="skill-level">Cerrah</div>
            </div>
            <div class="skill-desc">
                Legacy kodu okumak, koparmak, yeniden düzenlemek. Panik yok.
            </div>
        </div>

        <div class="skill-item">
            <div class="skill-head">
                <div class="skill-name">Danışmanlık</div>
                <div class="skill-level">Partner</div>
            </div>
            <div class="skill-desc">
                “Biz ne yapıyoruz şu an?” sorusuna net yol haritası çıkarırım.
            </div>
        </div>
    </div>
</section>

<!-- PRICING -->
<section id="pricing" class="container">
    <div class="section-header">
        <div class="section-eyebrow">Fiyatlar</div>
        <div class="section-title">Freelance paketlerim</div>
        <div class="section-desc">
            Aşağıdaki ücretler başlangıç noktasıdır. Kurumsal iş için teklif ayrı olur.
        </div>
    </div>

    <div class="pricing-wrap">
        <!-- Paket 1 -->
        <div class="price-card">
            <div class="price-head">
                <div class="plan-name">
                    <span>Hızlı Fix / Destek</span>
                </div>
                <div class="plan-desc">
                    Acil bug, ufak feature, hotfix. Mevcut sisteme dokunuyorum.
                </div>
                <div class="plan-price">Fiyatı görüşürüz.</div>
            </div>

            <ul class="plan-features">
                <li><span class="check">✔</span> Var olan projeye dahil olurum</li>
                <li><span class="check">✔</span> 1 modül / 1 sorun</li>
                <li><span class="check">✔</span> Kod temizliği, açıklama, loglama</li>
            </ul>

            <div class="price-cta">
                <a href="#contact"><button class="btn-primary">Talep Et</button></a>
            </div>
        </div>

        <!-- Paket 2 -->
        <div class="price-card" style="border:1px solid var(--accent);">
            <div class="price-head">
                <div class="plan-name">
                    <span>Mini Panel / Dashboard</span>
                    <span style="font-size:.65rem; background-color:var(--accent); color:#0f172a; font-weight:600; border-radius:.4rem; padding:.2rem .4rem; line-height:1;">Popüler</span>
                </div>
                <div class="plan-desc">
                    Yönetim paneli, rapor ekranı, CRUD akışı. Sıfırdan.
                </div>
                <div class="plan-price">Fiyatı görüşürüz</div>
            </div>

            <ul class="plan-features">
                <li><span class="check">✔</span> Giriş / yetki / rol yapısı</li>
                <li><span class="check">✔</span> MSSQL & EF Core entegrasyonu</li>
                <li><span class="check">✔</span> Mobil uyumlu arayüz</li>
            </ul>

            <div class="price-cta">
                <a href="#contact"><button class="btn-primary">Talep Et</button></a>
            </div>
        </div>

        <!-- Paket 3 -->
        <div class="price-card">
            <div class="price-head">
                <div class="plan-name">
                    <span>Kurumsal Çözüm</span>
                </div>
                <div class="plan-desc">
                    Süreç analizi, veri modeli, servis mimarisi, raporlama hattı.
                </div>
                <div class="plan-price">Fiyatı görüşürüz</div>
            </div>

            <ul class="plan-features">
                <li><span class="check">✔</span> Analiz + teknik dokümantasyon</li>
                <li><span class="check">✔</span> Security, audit, log tasarımı</li>
                <li><span class="check">✔</span> Yol haritası & sprint planı</li>
            </ul>

            <div class="price-cta">
                <a href="#contact"><button class="btn-primary">Toplantı Ayarla</button></a>
            </div>
        </div>
    </div>
</section>

<!-- CONTACT -->
<section id="contact" class="container">
    <div class="section-header">
        <div class="section-eyebrow">İletişim</div>
        <div class="section-title">Birlikte çalışmak ister misin?</div>
        <div class="section-desc">
            Formu doldur. Mail olarak düşsün. (Spam bot değilsen sorun yok 😌)
        </div>
    </div>

    <div class="contact-grid">
        <div class="card contact-left">
            <p>
                Teknik borcun mu var? Canlı sistem mi yanıyor?
                Ya da sıfırdan panel mi istiyorsun?
            </p>
            <p>
                Yaz. Durumu kısaca anlat. Ben dönerim.
            </p>

            <div class="mt-3" style="font-size:.8rem;color:var(--text-dim);line-height:1.4;">
                Alternatif:
                <div>LinkedIn: <a href="https://www.linkedin.com/in/furkantural">furkantural</a></div>
                <div>Github: <a href="https://github.com/headclef">headclef</a></div>
                <div>Instagram: <a href="https://www.instagram.com/headclef">headclef</a></div>
                <div>Facebook: <a href="https://www.facebook.com/headcleFT">headcleFT</a></div>
                <div>Hackerrank: <a href="https://www.hackerrank.com/profile/elbisetakim">elbisetakim</a></div>
            </div>
        </div>

        <div class="card">
            @using (Html.BeginForm("SendMail", "Base", method: FormMethod.Post, htmlAttributes: new { id = "contactForm" }))
            {
                @Html.AntiForgeryToken()

                <div class="field">
                    @Html.Label("NameSurname", "Ad Soyad")
                    @Html.TextBox("NameSurname", "", htmlAttributes: new { id = "NameSurname", name = "NameSurname", type = "text", placeholder = "Adın", required = "required" })
                </div>

                <div class="field">
                    @Html.Label("Email", "E-posta")
                    @Html.TextBox("Email", "", htmlAttributes: new { id = "Email", name = "Email", type = "email", placeholder = "ornek@firma.com", required = "required" })
                </div>

                <div class="field">
                    @Html.Label("MessageNeed", "Mesajın / İhtiyacın")
                    @Html.TextArea("MessageNeed", "", htmlAttributes: new { id = "MessageNeed", name = "MessageNeed", placeholder = "Neye ihtiyacın var? Deadline, sistem, teknoloji...", required = "required" })
                    <div class="form-hint mt-2">
                        Gönderince sağ altta durum çıkacak.
                    </div>
                </div>

                <div class="field" style="display:flex; flex-direction:column; align-items:center; gap:.5rem;">
                    <label style="font-size:.75rem;font-weight:500;color:var(--text-main);">
                        Güvenlik Doğrulaması
                        <span style="font-size:.65rem;font-weight:400;color:var(--text-dim);">
                            (bot musun insan mısın testi)
                        </span>
                    </label>

                    <div class="cf-turnstile"
                         data-sitekey="@turnstileOptions.Value.SiteKey"
                         data-callback="turnstileCallback"
                         data-theme="auto">
                    </div>

                    @Html.Hidden("TurnstileResponse", "", new { id = "TurnstileResponse" })

                    <div class="form-hint mt-2">
                        Bunu yapmak zorundayız çünkü internet çöplük dolu 🙂
                    </div>
                </div>

                <button type="submit" id="contactSubmitBtn" class="btn-primary" style="width:100%;">
                    Gönder
                </button>
            }
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <script src="~/js/site.js"></script>
    <script>
        function turnstileCallback(token) {
            document.getElementById("TurnstileResponse").value = token;
        }
    </script>
}