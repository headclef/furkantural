@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link href="~/css/site.css" rel="stylesheet" />
    <link href="~/css/error.css" rel="stylesheet" />
}

@if (Model is null)
{
    <div class="error-page-container">
        <div class="error-card">
            <div class="status-code">
                <span id="errCode">@Localizer["Error_Default_Code"]</span>
                <span class="status-label" id="errLabel">@Localizer["Error_Default_Label"]</span>
            </div>

            <div class="status-message" id="errMessage">
                @Localizer["Error_Default_Message"]
            </div>

            <div class="status-desc" id="errDesc">
                @Localizer["Error_Default_Desc"]
            </div>

            <div class="actions">
                <button class="btn btn-outline" id="btnBack" onclick="history.back()">@Localizer["Btn_Back"]</button>
                <a class="btn btn-primary" id="btnHome" href="/">@Localizer["Btn_Home"]</a>
            </div>

            <div class="footer-hint">
                <div id="techHint"></div>
            </div>
        </div>
    </div>
}
else
{
    <div class="error-page-container">
        <div class="error-card">
            <div class="status-code">
                <span id="errCode">@Model.Code</span>
                <span class="status-label" id="errLabel">@Model.Type</span>
            </div>

            <div class="status-message" id="errMessage">
                @Model.Message
            </div>

            <div class="status-desc" id="errDesc">
                @Model.Detail            
            </div>

            <div class="actions">
                <button class="btn btn-outline" id="btnBack" onclick="history.back()">@Localizer["Btn_Back"]</button>
                <a asp-action="Index" asp-controller="Base" class="btn btn-primary" id="btnHome">@Localizer["Btn_Home"]</a>
            </div>

            <div class="footer-hint">
                <div id="techHint"></div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/error.js"></script>
}