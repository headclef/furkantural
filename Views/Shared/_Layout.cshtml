@inject IOptions<VersionOptions> versionConfiguration;
@inject IHtmlLocalizer<SharedResource> SharedLocalizer
@{
    var pageTitle = ViewData["Title"]?.ToString() ?? "Full-Stack Developer";
    var siteTitle = "Furkan Tural";
    var fullTitle = $"{pageTitle} | {siteTitle}";
    var description = "Furkan Tural - Full-Stack Developer, Backend Developer, Website Developer. Professional portfolio showcasing projects and skills.";
    var siteUrl = "https://furkantural.com";
    var currentUrl = $"{siteUrl}{Context.Request.Path}";
}
<!DOCTYPE html>
<html lang="tr" data-theme="dark">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Primary Meta Tags -->
    <title>@fullTitle</title>
    <meta name="title" content="@fullTitle" />
    <meta name="description" content="@description" />
    <meta name="keywords" content="Furkan Tural, Full-Stack Developer, Backend Developer, Website Developer, Portfolio, .NET Developer" />
    <meta name="author" content="Furkan Tural" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="@currentUrl" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@currentUrl" />
    <meta property="og:title" content="@fullTitle" />
    <meta property="og:description" content="@description" />
    <meta property="og:site_name" content="@siteTitle" />
    <meta property="og:locale" content="tr_TR" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary" />
    <meta property="twitter:url" content="@currentUrl" />
    <meta property="twitter:title" content="@fullTitle" />
    <meta property="twitter:description" content="@description" />
    
    <!-- Social Profile Links -->
    <meta property="og:see_also" content="https://www.linkedin.com/in/furkantural" />
    <meta property="og:see_also" content="https://github.com/headclef" />
    <meta property="og:see_also" content="https://www.instagram.com/headclef" />
    <meta property="og:see_also" content="https://www.facebook.com/headcleFT" />
    
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    
    <!-- Stylesheets -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "Person",
        "name": "Furkan Tural",
        "url": "https://furkantural.com",
        "jobTitle": "Full-Stack Developer",
        "description": "@description",
        "sameAs": [
            "https://www.linkedin.com/in/furkantural",
            "https://github.com/headclef",
            "https://www.instagram.com/headclef",
            "https://www.facebook.com/headcleFT",
            "https://www.hackerrank.com/profile/elbisetakim"
        ]
    }
    </script>
</head>

<body>
    <div id="canvas-container"></div>
    @await RenderSectionAsync("Styles", required: false)
    <header class="navbar">
        <div class="nav-inner">
            <div class="brand"><a asp-action="Index" asp-controller="Base" style="text-decoration: none;">Furkan<span>Tural</span></a></div>

            <nav class="nav-links">
                <a href="#home">@SharedLocalizer["Navbar_Home"]</a>
                <a href="#about">@SharedLocalizer["Navbar_About"]</a>
                <a href="#skills">@SharedLocalizer["Navbar_Skills"]</a>
                <a href="#projects">@SharedLocalizer["Navbar_Projects"]</a>
                <a href="#songs">@SharedLocalizer["Navbar_Songs"]</a>
                <a href="#pricing">@SharedLocalizer["Navbar_Pricing"]</a>
                <a href="#contact">@SharedLocalizer["Navbar_Contact"]</a>
            </nav>

            <div style="display: flex; align-items: center; gap: 10px;">
                <div class="lang-switcher" style="margin-left: 10px;">
                    <form asp-controller="Base" asp-action="SetLanguage" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString" method="post">
                         <select name="culture" onchange="this.form.submit()" class="lang-select">
                            @{
                                var requestCulture = Context.Features.Get<Microsoft.AspNetCore.Localization.IRequestCultureFeature>();
                                var currentCulture = requestCulture?.RequestCulture.UICulture.Name;
                                var cultures = new[] { "tr", "en", "de", "fr", "ru" };
                            }
                            @foreach (var c in cultures)
                            {
                                 <option value="@c" selected="@(c == currentCulture ? "selected" : null)">@c.ToUpper()</option>
                            }
                        </select>
                    </form>
                </div>
                <button id="themeToggle" class="theme-toggle-btn" aria-label="@SharedLocalizer["Theme_Toggle_Label"]">
                    <span id="themeIcon">🌙</span>
                    <span class="toggle-text">@SharedLocalizer["Theme_Dark"]</span>
                </button>
            </div>
        </div>
    </header>
    <main>
        @RenderBody()
    </main>
    <footer class="footer">
        <div class="footer-inner">
            <div class="footer-left">
                © <span id="year"></span> Furkan Tural
            </div>
            <div class="footer-right">
                @versionConfiguration.Value.Version
            </div>
        </div>
    </footer>
    <!-- Three.js from CDN (Global) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="~/js/site-3d.js"></script>
    <script src="~/js/site.js"></script>
    <script src="~/js/site-3d-ui.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>