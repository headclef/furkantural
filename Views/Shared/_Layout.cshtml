@using Microsoft.Extensions.Options
@inject IOptions<VersionViewModel> versionConfiguration;
@inject IHtmlLocalizer<SharedResource> SharedLocalizer
<!DOCTYPE html>
<html lang="tr" data-theme="dark">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1.0" />
    <title>Furkan Tural</title>
    <!-- META DATAS -->
    <meta charset="utf-8" />
    <meta name="description" content="Website Developer, Backend Developer, Full-Stack Developer, Developer, Website, Backend, Full-Stack" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
</head>
<body>
    <div id="canvas-container"></div>
    @await RenderSectionAsync("Styles", required: false)
    <header class="navbar">
        <div class="nav-inner">
            <div class="brand"><a asp-action="Index" asp-controller="Base" style="text-decoration: none;">Furkan<span>Tural</span></a></div>

            <nav class="nav-links">
                <a href="#home">@SharedLocalizer["Navbar_Home"]</a>
                <a href="#about">@SharedLocalizer["Navbar_About"]</a>
                <a href="#skills">@SharedLocalizer["Navbar_Skills"]</a>
                <a href="#projects">@SharedLocalizer["Navbar_Projects"]</a>
                <a href="#pricing">@SharedLocalizer["Navbar_Pricing"]</a>
                <a href="#contact">@SharedLocalizer["Navbar_Contact"]</a>
            </nav>

            <div style="display: flex; align-items: center; gap: 10px;">
                <div class="lang-switcher" style="margin-left: 10px;">
                    <form asp-controller="Base" asp-action="SetLanguage" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString" method="post">
                         <select name="culture" onchange="this.form.submit()" class="lang-select">
                            @{
                                var requestCulture = Context.Features.Get<Microsoft.AspNetCore.Localization.IRequestCultureFeature>();
                                var currentCulture = requestCulture?.RequestCulture.UICulture.Name;
                                var cultures = new[] { "tr", "en", "de", "fr", "ru" };
                            }
                            @foreach (var c in cultures)
                            {
                                 <option value="@c" selected="@(c == currentCulture ? "selected" : null)">@c.ToUpper()</option>
                            }
                        </select>
                    </form>
                </div>
                <button id="themeToggle" class="theme-toggle-btn" aria-label="@SharedLocalizer["Theme_Toggle_Label"]">
                    <span id="themeIcon">🌙</span>
                    <span class="toggle-text">@SharedLocalizer["Theme_Dark"]</span>
                </button>
            </div>
        </div>
    </header>
    <main>
        @RenderBody()
    </main>
    <footer class="footer">
        <div class="footer-inner">
            <div class="footer-left">
                © <span id="year"></span> Furkan Tural
            </div>
            <div class="footer-right">
                @versionConfiguration.Value.Version
            </div>
        </div>
    </footer>
    <!-- Three.js from CDN (Global) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="~/js/site-3d.js"></script>
    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>