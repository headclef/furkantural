<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
  		<EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    	<RootNamespace>furkantural</RootNamespace>
    	<AssemblyName>furkantural</AssemblyName>
		<DefaultItemExcludes>$(DefaultItemExcludes);furkantural.Domain\**;furkantural.Application\**;furkantural.Infrastructure\**;furkantural.Application.Tests\**;furkantural.Infrastructure.Tests\**;furkantural.Tools\**</DefaultItemExcludes>
	</PropertyGroup>

	<ItemGroup>
	  <EmbeddedResource Include="Resources\**\*.resx" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="8.0.7" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="furkantural.Application\furkantural.Application.csproj" />
		<ProjectReference Include="furkantural.Infrastructure\furkantural.Infrastructure.csproj" />
	</ItemGroup>

</Project>